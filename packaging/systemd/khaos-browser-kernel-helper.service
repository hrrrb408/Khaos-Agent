[Unit]
Description=Khaos root browser kernel authority
Requires=khaos-agent.service
After=khaos-agent.service

[Service]
Type=simple
User=root
Group=root
Environment=KHAOS_BROWSER_KERNEL_HELPER_SOCKET=/run/khaos-helper/browser-kernel-helper.sock
Environment=KHAOS_BROWSER_HELPER_SECRET_FILE=/var/lib/khaos/browser-helper.secret
Environment=KHAOS_BROWSER_HELPER_JOURNAL_ROOT=/run/khaos-helper/journal
ExecStart=/bin/sh -ec 'client_pid="$$(systemctl show --property MainPID --value khaos-agent.service)"; test "$${client_pid}" -gt 1; client_uid="$$(id -u khaos)"; exec env KHAOS_BROWSER_KERNEL_HELPER_CLIENT_PID="$${client_pid}" KHAOS_BROWSER_KERNEL_HELPER_UID="$${client_uid}" /usr/local/sbin/khaos-browser-kernel-helper'
Restart=on-failure
RuntimeDirectory=khaos-helper khaos-helper/journal
RuntimeDirectoryMode=0755
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/khaos-helper /var/lib/khaos /run/netns /sys/fs/cgroup/khaos-browser

[Install]
WantedBy=multi-user.target
