{
  "name": "Protect main branch",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"exclude": [], "include": ["~DEFAULT_BRANCH"]}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["merge"],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "DB Transaction Adversarial"},
          {"context": "Shared DB Project Isolation"},
          {"context": "Browser Netns Attack E2E"},
          {"context": "Go Race Test"},
          {"context": "Rust Clippy"},
          {"context": "Full Python Security Suite"},
          {"context": "Migration Fixture Matrix"},
          {"context": "linux-bwrap-security"},
          {"context": "browser-kernel-isolation"},
          {"context": "fullstack-browser-kernel"},
          {"context": "macos-sandbox-security"},
          {"context": "windows-fail-closed-security"},
          {"context": "playwright-security"},
          {"context": "contract (ubuntu-24.04)"},
          {"context": "contract (windows-2025)"},
          {"context": "contract (macos-14)"},
          {"context": "docker-isolation"},
          {"context": "pip-audit (Python)"},
          {"context": "cargo audit (Rust)"},
          {"context": "govulncheck (Go)"}
        ]
      }
    }
  ]
}
