# Copy to .env and keep the referenced files outside Git.
KHAOS_PYTHON_CAPABILITY_FILE=.secrets/python-capability
KHAOS_BROWSER_HELPER_SECRET_FILE=.secrets/browser-helper-secret
KHAOS_API_KEY_FILE=.secrets/gateway-api-key
# Explicit operator principals for GET/PUT /api/config.  Values use the
# authenticated principal format, e.g. api-key:<sha256(api-key)>, not raw keys.
KHAOS_CONFIG_ADMIN_PRINCIPALS=api-key:<sha256-hex>

# Production only.  Use comma-separated exact HTTP Host names.
KHAOS_ALLOWED_HOSTS=localhost,127.0.0.1
KHAOS_TLS_CERT_FILE=.secrets/tls-cert.pem
KHAOS_TLS_KEY_FILE=.secrets/tls-key.pem
